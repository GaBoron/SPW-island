{
  "configs": [
    {
      "title": "显示与交互",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "enabled",
          "title": "显示词岛",
          "default_value": true
        },
        {
          "type": "button",
          "title": "找回词岛",
          "summary": "显示词岛、解除鼠标穿透并回到主屏幕顶部。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.recover"
        },
        {
          "type": "switch",
          "key": "hide_paused",
          "title": "暂停时隐藏",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "hide_fullscreen",
          "title": "全屏时隐藏（Windows）",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "click_through",
          "title": "鼠标穿透",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "auto_hide_on_hover",
          "title": "鼠标经过时自动隐藏",
          "default_value": false,
          "summary": "开启后同时穿透鼠标，移入隐藏、移开恢复。GNOME Wayland 需在“工具与关于”安装配套扩展。"
        },
        {
          "type": "switch",
          "key": "scroll_volume",
          "title": "鼠标滚轮调节音量",
          "default_value": false,
          "summary": "悬停展开后滚动，每格调节 2% 的 SPW 音量；音量条可点击、拖动。穿透或悬停隐藏时不可用。"
        },
        {
          "type": "switch",
          "key": "reduced_motion",
          "title": "低性能模式",
          "default_value": false,
          "summary": "降低刷新率，使用简化高亮和模拟频谱，停用实时音频捕获、液态玻璃与复杂动效。"
        }
      ]
    },
    {
      "title": "歌词显示",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "translation",
          "title": "显示翻译",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "karaoke",
          "title": "逐字高亮与长音强调",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "force_karaoke",
          "title": "强制逐字显示",
          "default_value": false,
          "summary": "为普通 LRC 估算逐字进度，需开启逐字高亮。原生时间轴优先；估算内容不应用长音发光。"
        },
        {
          "type": "seekbar",
          "key": "offset_ms",
          "title": "逐字高亮偏移 ms",
          "default_value": 0,
          "min": -2000,
          "max": 2000
        },
        {
          "type": "switch",
          "key": "experimental_multi_line",
          "title": "实验性多行歌词",
          "default_value": false,
          "summary": "使用 SPW 提供的完整歌词时间轴，保留尚未结束的已播歌词；发生重叠时自动展开显示。"
        },
        {
          "type": "switch",
          "key": "lyric_cover_color",
          "title": "歌词高亮与辉光使用封面颜色",
          "default_value": false,
          "summary": "从封面取色，用于歌词高亮和长音辉光；无封面时使用默认颜色。"
        }
      ]
    },
    {
      "title": "字体",
      "config": "island.json",
      "preferences": [
        {
          "type": "seekbar",
          "key": "font_size",
          "title": "字号",
          "default_value": 22,
          "min": 12,
          "max": 72
        },
        {
          "type": "button",
          "title": "歌词字体（Windows）",
          "summary": "选择字体及其提供的字形，预览词岛效果。",
          "arrow_type": "arrow",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.chooseFont"
        },
        {
          "type": "edittext",
          "key": "font_family",
          "title": "歌词字体（Linux）",
          "default_value": "",
          "summary": "Linux 使用此项设置字体；留空使用内置 MiSans。Windows 请使用上方字体窗口。"
        },
        {
          "type": "list",
          "key": "font_weight",
          "title": "歌词字重（Linux）",
          "entries": [
            "极细 100",
            "细体 300",
            "次细 350",
            "常规 400",
            "中等 500",
            "粗体 700",
            "极粗 900"
          ],
          "entry_values": [
            "100",
            "300",
            "350",
            "400",
            "500",
            "700",
            "900"
          ],
          "default_value": "400",
          "summary": "Linux 使用此项选择字重。自选字体缺少对应字重时使用最接近的已有字重。"
        }
      ]
    },
    {
      "title": "外观与布局",
      "config": "island.json",
      "preferences": [
        {
          "type": "list",
          "key": "shape",
          "title": "外观",
          "entries": [
            "胶囊",
            "顶部刘海"
          ],
          "entry_values": [
            "pill",
            "notch"
          ],
          "default_value": "pill"
        },
        {
          "type": "seekbar",
          "key": "corner_roundness",
          "title": "圆角大小 %",
          "default_value": 95,
          "min": 0,
          "max": 100,
          "summary": "0 为直角，100 为最大圆角；圆角会随词岛高度自动缩放。"
        },
        {
          "type": "seekbar",
          "key": "max_width",
          "title": "最大宽度",
          "default_value": 640,
          "min": 280,
          "max": 1200
        },
        {
          "type": "switch",
          "key": "fixed_width",
          "title": "固定词岛宽度",
          "default_value": false,
          "summary": "开启后始终使用“最大宽度”的值，不再随歌词长度收缩。"
        }
      ]
    },
    {
      "title": "背景与进度",
      "config": "island.json",
      "preferences": [
        {
          "type": "list",
          "key": "background_style",
          "title": "背景样式（Windows）",
          "entries": [
            "经典背景",
            "液态玻璃（实验性）"
          ],
          "entry_values": [
            "classic",
            "liquid_glass"
          ],
          "default_value": "classic",
          "summary": "液态玻璃需要 Windows 11、SDR 显示器和 GPU 绘制；启用后词岛不出现在系统录屏中。低性能或捕获不可用时使用经典背景。"
        },
        {
          "type": "seekbar",
          "key": "opacity",
          "title": "背景不透明度 %",
          "default_value": 96,
          "min": 35,
          "max": 100
        },
        {
          "type": "switch",
          "key": "background_cover_color",
          "title": "背景使用封面颜色",
          "default_value": false,
          "summary": "仅经典背景生效；无封面时使用默认颜色。"
        },
        {
          "type": "list",
          "key": "background_progress",
          "title": "背景播放进度样式",
          "entries": [
            "关闭",
            "背景注水",
            "边缘细线"
          ],
          "entry_values": [
            "off",
            "fill",
            "top_line"
          ],
          "default_value": "off",
          "summary": "收起时显示播放进度；胶囊细线在顶部，刘海细线在底部。低性能模式下关闭。"
        }
      ]
    },
    {
      "title": "封面与频谱",
      "config": "island.json",
      "preferences": [
        {
          "type": "list",
          "key": "leading_content",
          "title": "两侧信息",
          "entries": [
            "左侧封面 + 右侧频谱",
            "左侧实时频谱",
            "左侧专辑封面",
            "都不显示"
          ],
          "entry_values": [
            "cover_spectrum",
            "spectrum",
            "cover",
            "none"
          ],
          "default_value": "cover_spectrum",
          "summary": "单项模式在右侧保留播放状态；封面来自本地音频或同目录图片。"
        },
        {
          "type": "switch",
          "key": "spectrum_cover_color",
          "title": "频谱使用封面颜色",
          "default_value": false,
          "summary": "使用封面颜色绘制频谱；无封面时使用默认颜色。"
        }
      ]
    },
    {
      "title": "工具与关于",
      "config": "island.json",
      "preferences": [
        {
          "type": "button",
          "title": "打开日志目录",
          "summary": "异常与关键操作日志默认开启，保留 10 天；词岛无法显示时也可使用。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.openLogs"
        },
        {
          "type": "button",
          "title": "导出诊断包",
          "summary": "将日志与运行环境导出为 ZIP。分享前请检查异常堆栈中可能包含的隐私信息；不会自动上传。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.exportDiagnostics"
        },
        {
          "type": "button",
          "title": "安装 GNOME 悬停隐藏支持（Linux）",
          "summary": "适用于 GNOME Wayland 45–50；首次安装或更新配套指针扩展后需重新登录。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.installGnomePointer"
        },
        {
          "type": "button",
          "title": "关于与状态",
          "summary": "查看运行状态、Lyricify / AMLL 署名及许可证信息。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.about"
        },
        {
          "type": "button",
          "title": "项目源代码（GitHub）",
          "summary": "查看源代码、反馈问题与参与贡献。",
          "arrow_type": "link",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.openSource"
        },
        {
          "type": "button",
          "title": "重置设置",
          "summary": "将所有词岛设置、字体和位置恢复为默认值；设置页中的数值可能需要重新打开后才会更新。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.resetSettings"
        }
      ]
    }
  ]
}
