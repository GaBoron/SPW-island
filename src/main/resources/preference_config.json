{
  "configs": [
    {
      "title": "显示与交互",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "enabled",
          "title": "显示词岛",
          "default_value": true
        },
        {
          "type": "button",
          "title": "找回词岛",
          "summary": "显示词岛、解除鼠标穿透并回到主屏幕顶部。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.recover"
        },
        {
          "type": "switch",
          "key": "hide_paused",
          "title": "暂停时隐藏",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "hide_fullscreen",
          "title": "全屏时隐藏（Windows）",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "click_through",
          "title": "鼠标穿透",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "auto_hide_on_hover",
          "title": "鼠标经过时自动隐藏",
          "default_value": false,
          "summary": "移入隐藏、移开恢复，并开启鼠标穿透。GNOME Wayland 需安装配套支持。"
        },
        {
          "type": "switch",
          "key": "scroll_volume",
          "title": "鼠标滚轮调节音量",
          "default_value": false,
          "summary": "每格调节 2% 的 SPW 音量；穿透或悬停隐藏时不可用。"
        },
        {
          "type": "switch",
          "key": "reduced_motion",
          "title": "低性能模式",
          "default_value": false,
          "summary": "降低刷新率并简化动效，使用模拟频谱和经典背景。"
        }
      ]
    },
    {
      "title": "歌词显示",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "translation",
          "title": "显示翻译",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "karaoke",
          "title": "逐字高亮与长音强调",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "force_karaoke",
          "title": "强制逐字显示",
          "default_value": false,
          "summary": "估算普通 LRC 的逐字进度，需开启逐字高亮。"
        },
        {
          "type": "seekbar",
          "key": "offset_ms",
          "title": "逐字高亮偏移 ms",
          "default_value": 0,
          "min": -2000,
          "max": 2000,
          "summary": "正值提前，负值延后。"
        },
        {
          "type": "switch",
          "key": "experimental_multi_line",
          "title": "实验性多行歌词",
          "default_value": false,
          "summary": "同时显示时间重叠的歌词行。"
        },
        {
          "type": "switch",
          "key": "lyric_cover_color",
          "title": "歌词高亮与辉光使用封面颜色",
          "default_value": false
        }
      ]
    },
    {
      "title": "字体",
      "config": "island.json",
      "preferences": [
        {
          "type": "seekbar",
          "key": "font_size",
          "title": "字号",
          "default_value": 22,
          "min": 12,
          "max": 72
        },
        {
          "type": "button",
          "title": "歌词字体（Windows）",
          "arrow_type": "arrow",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.chooseFont"
        },
        {
          "type": "edittext",
          "key": "font_family",
          "title": "歌词字体（Linux）",
          "default_value": "",
          "summary": "留空使用内置 MiSans。"
        },
        {
          "type": "list",
          "key": "font_weight",
          "title": "歌词字重（Linux）",
          "entries": [
            "极细 100",
            "细体 300",
            "次细 350",
            "常规 400",
            "中等 500",
            "粗体 700",
            "极粗 900"
          ],
          "entry_values": [
            "100",
            "300",
            "350",
            "400",
            "500",
            "700",
            "900"
          ],
          "default_value": "400",
          "summary": "缺少指定字重时使用最接近的可用字重。"
        }
      ]
    },
    {
      "title": "外观与布局",
      "config": "island.json",
      "preferences": [
        {
          "type": "list",
          "key": "shape",
          "title": "外观",
          "entries": [
            "胶囊",
            "顶部刘海"
          ],
          "entry_values": [
            "pill",
            "notch"
          ],
          "default_value": "pill"
        },
        {
          "type": "seekbar",
          "key": "corner_roundness",
          "title": "圆角大小 %",
          "default_value": 95,
          "min": 0,
          "max": 100,
          "summary": "0 为直角，100 为最大圆角。"
        },
        {
          "type": "seekbar",
          "key": "max_width",
          "title": "最大宽度",
          "default_value": 640,
          "min": 280,
          "max": 1200
        },
        {
          "type": "switch",
          "key": "fixed_width",
          "title": "固定词岛宽度",
          "default_value": false,
          "summary": "始终使用“最大宽度”，不随歌词长度收缩。"
        }
      ]
    },
    {
      "title": "背景与进度",
      "config": "island.json",
      "preferences": [
        {
          "type": "list",
          "key": "background_style",
          "title": "背景样式",
          "entries": [
            "经典背景",
            "液态玻璃（实验性）"
          ],
          "entry_values": [
            "classic",
            "liquid_glass"
          ],
          "default_value": "classic",
          "summary": "Windows 需 Windows 11 SDR；Linux 需安装下方支持。低性能模式下不可用。"
        },
        {
          "type": "button",
          "title": "安装 / 修复 Linux 液态玻璃支持",
          "summary": "GNOME 50；Arch KDE（KWin 6.6–6.8 Wayland）。GNOME 安装会启用用户扩展，完成后重新登录。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.installGnomeGlass"
        },
        {
          "type": "seekbar",
          "key": "opacity",
          "title": "背景不透明度 %",
          "default_value": 96,
          "min": 35,
          "max": 100
        },
        {
          "type": "switch",
          "key": "background_cover_color",
          "title": "背景使用封面颜色",
          "default_value": false,
          "summary": "仅经典背景生效。"
        },
        {
          "type": "list",
          "key": "background_progress",
          "title": "背景播放进度样式",
          "entries": [
            "关闭",
            "背景注水",
            "边缘细线"
          ],
          "entry_values": [
            "off",
            "fill",
            "top_line"
          ],
          "default_value": "off",
          "summary": "收起时显示；低性能模式下关闭。"
        }
      ]
    },
    {
      "title": "封面与频谱",
      "config": "island.json",
      "preferences": [
        {
          "type": "list",
          "key": "leading_content",
          "title": "两侧信息",
          "entries": [
            "左侧封面 + 右侧频谱",
            "左侧实时频谱",
            "左侧专辑封面",
            "都不显示"
          ],
          "entry_values": [
            "cover_spectrum",
            "spectrum",
            "cover",
            "none"
          ],
          "default_value": "cover_spectrum",
          "summary": "单项模式右侧显示播放状态。"
        },
        {
          "type": "switch",
          "key": "spectrum_cover_color",
          "title": "频谱使用封面颜色",
          "default_value": false
        }
      ]
    },
    {
      "title": "工具与关于",
      "config": "island.json",
      "preferences": [
        {
          "type": "button",
          "title": "打开日志目录",
          "summary": "保留最近 10 天日志。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.openLogs"
        },
        {
          "type": "button",
          "title": "导出诊断包",
          "summary": "导出日志和运行环境，不会自动上传；分享前请检查个人信息。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.exportDiagnostics"
        },
        {
          "type": "button",
          "title": "安装 GNOME 悬停隐藏支持（Linux）",
          "summary": "适用于 GNOME Wayland 45–50。会启用用户扩展；安装或更新后需重新登录。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.installGnomePointer"
        },
        {
          "type": "button",
          "title": "关于与状态",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.about"
        },
        {
          "type": "button",
          "title": "项目源代码（GitHub）",
          "arrow_type": "link",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.openSource"
        },
        {
          "type": "button",
          "title": "重置设置",
          "summary": "恢复所有设置（含字体和位置）；重新打开设置页以刷新显示。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.resetSettings"
        }
      ]
    }
  ]
}
