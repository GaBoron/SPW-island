{
  "configs": [
    {
      "title": "灵动词岛",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "enabled",
          "title": "显示词岛",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "translation",
          "title": "显示翻译",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "karaoke",
          "title": "逐字高亮与长音强调",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "experimental_multi_line",
          "title": "实验性多行歌词",
          "default_value": false,
          "summary": "保留尚未结束的已播歌词，并尝试读取 SPW 内部完整歌词轴；发生重叠时自动展开显示。"
        },
        {
          "type": "switch",
          "key": "click_through",
          "title": "鼠标穿透",
          "default_value": false,
          "summary": "点击穿过词岛，不影响下方窗口；可通过托盘或插件设置解除。"
        },
        {
          "type": "switch",
          "key": "auto_hide_on_hover",
          "title": "鼠标经过时自动隐藏",
          "default_value": false,
          "summary": "开启后同时穿透鼠标，经过词岛时隐藏、移开后恢复。支持 X11、KDE Wayland；GNOME Wayland 需先安装下方配套扩展。"
        },
        {
          "type": "button",
          "title": "安装 GNOME 悬停隐藏支持",
          "summary": "GNOME 45–50 配套指针扩展；首次安装或更新后需重新登录。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.installGnomePointer"
        },
        {
          "type": "switch",
          "key": "hide_paused",
          "title": "暂停时隐藏",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "reduced_motion",
          "title": "低性能模式",
          "default_value": false,
          "summary": "降低刷新率，使用简化高亮和模拟频谱，停用实时音频捕获与复杂动效。"
        },
        {
          "type": "list",
          "key": "shape",
          "title": "外观",
          "entries": [
            "胶囊",
            "顶部刘海"
          ],
          "entry_values": [
            "pill",
            "notch"
          ],
          "default_value": "pill"
        },
        {
          "type": "seekbar",
          "key": "corner_roundness",
          "title": "圆角大小 %",
          "default_value": 95,
          "min": 0,
          "max": 100,
          "summary": "0 为直角，100 为最大圆角；圆角会随词岛高度自动缩放。"
        },
        {
          "type": "edittext",
          "key": "font_family",
          "title": "歌词字体（可选）",
          "default_value": "",
          "summary": "留空使用插件内置的 MiSans；填写已安装字体名称时仅影响歌词。缺失字形先由内置字体补全，再由系统字体补全。"
        },
        {
          "type": "list",
          "key": "font_weight",
          "title": "歌词字重",
          "entries": [
            "极细 100",
            "细体 300",
            "次细 350",
            "常规 400",
            "中等 500",
            "粗体 700",
            "极粗 900"
          ],
          "entry_values": [
            "100",
            "300",
            "350",
            "400",
            "500",
            "700",
            "900"
          ],
          "default_value": "400",
          "summary": "内置 MiSans 提供字重预设；自选字体优先使用对应的真实字重，缺少该档时使用最接近的已有字重。"
        },
        {
          "type": "seekbar",
          "key": "font_size",
          "title": "字号",
          "default_value": 22,
          "min": 14,
          "max": 42
        },
        {
          "type": "seekbar",
          "key": "max_width",
          "title": "最大宽度",
          "default_value": 640,
          "min": 280,
          "max": 1200
        },
        {
          "type": "switch",
          "key": "fixed_width",
          "title": "固定词岛宽度",
          "default_value": false,
          "summary": "开启后始终使用“最大宽度”的值，不再随歌词长度收缩。"
        },
        {
          "type": "list",
          "key": "leading_content",
          "title": "两侧信息",
          "entries": [
            "左侧封面 + 右侧频谱",
            "左侧实时频谱",
            "左侧专辑封面",
            "都不显示"
          ],
          "entry_values": [
            "cover_spectrum",
            "spectrum",
            "cover",
            "none"
          ],
          "default_value": "cover_spectrum",
          "summary": "实时频谱需要 PipeWire 及 pw-record / pw-dump，只采集 SPW 播放流；不可用时使用模拟频谱，状态可在托盘查看。"
        },
        {
          "type": "seekbar",
          "key": "opacity",
          "title": "背景不透明度 %",
          "default_value": 96,
          "min": 35,
          "max": 100
        },
        {
          "type": "seekbar",
          "key": "offset_ms",
          "title": "逐字高亮偏移 ms",
          "default_value": 0,
          "min": -2000,
          "max": 2000
        },
        {
          "type": "switch",
          "key": "lyric_cover_color",
          "title": "歌词高亮与辉光使用封面颜色",
          "default_value": false,
          "summary": "从本地音频内嵌封面或同目录 cover/folder 图片取色，无封面时使用默认颜色。"
        },
        {
          "type": "switch",
          "key": "spectrum_cover_color",
          "title": "频谱使用封面颜色",
          "default_value": false,
          "summary": "从本地音频内嵌封面或同目录 cover/folder 图片取色，无封面时使用默认颜色。"
        },
        {
          "type": "switch",
          "key": "background_cover_color",
          "title": "背景使用封面颜色",
          "default_value": false,
          "summary": "从本地音频内嵌封面或同目录 cover/folder 图片取色，无封面时使用默认颜色。"
        },
        {
          "type": "list",
          "key": "background_progress",
          "title": "背景播放进度样式",
          "entries": [
            "关闭",
            "背景注水",
            "边缘细线"
          ],
          "entry_values": [
            "off",
            "fill",
            "top_line"
          ],
          "default_value": "off",
          "summary": "胶囊沿顶部、刘海沿底部显示细线；开始隐藏或展开控件时淡出，恢复稳定收起状态后淡入，低性能模式下关闭。"
        },
        {
          "type": "button",
          "title": "重置设置",
          "summary": "将所有词岛设置、字体和位置恢复为默认值；设置页中的数值可能需要重新打开后才会更新。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.resetSettings"
        },
        {
          "type": "button",
          "title": "找回词岛",
          "summary": "解除鼠标穿透、显示词岛并回到主屏幕顶部。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.recover"
        },
        {
          "type": "button",
          "title": "原创署名与许可证（Lyricify / AMLL）",
          "summary": "Lyricify：CC BY-SA 4.0；AMLL 动画模块：AGPL-3.0；其他程序：GPL-3.0。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.about"
        },
        {
          "type": "button",
          "title": "项目源代码（GitHub）",
          "summary": "查看源代码、反馈问题与参与贡献。",
          "arrow_type": "link",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.openSource"
        }
      ]
    }
  ]
}
